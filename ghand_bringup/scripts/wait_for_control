#!/usr/bin/env python3
"""Activate a hardware component or verify that a trajectory action is ready."""

import argparse
import time

import rclpy
from control_msgs.action import FollowJointTrajectory
from controller_manager_msgs.srv import ListHardwareComponents, SetHardwareComponentState
from lifecycle_msgs.msg import State
from rclpy.action import ActionClient


def activate(node, name, deadline):
    def call(client, request):
        remaining = max(0.0, deadline - time.monotonic())
        if not client.wait_for_service(timeout_sec=remaining):
            return None
        future = client.call_async(request)
        rclpy.spin_until_future_complete(
            node, future, timeout_sec=max(0.0, deadline - time.monotonic()),
        )
        return future.result() if future.done() else None

    listing = node.create_client(ListHardwareComponents, "/controller_manager/list_hardware_components")
    while time.monotonic() < deadline and rclpy.ok():
        response = call(listing, ListHardwareComponents.Request())
        if response is None:
            break
        if any(component.name == name for component in response.component):
            service = node.create_client(
                SetHardwareComponentState, "/controller_manager/set_hardware_component_state",
            )
            request = SetHardwareComponentState.Request(
                name=name, target_state=State(id=State.PRIMARY_STATE_ACTIVE, label="active"),
            )
            response = call(service, request)
            if response is None:
                return f"Timed out activating hardware component {name}"
            if response.ok and response.state.id == State.PRIMARY_STATE_ACTIVE:
                return None
            return f"Hardware component {name} failed to activate (state={response.state.label})"
        time.sleep(0.1)
    return f"Timed out waiting for hardware component {name}"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("stage", choices=["hardware", "trajectory"])
    parser.add_argument("name")
    args = parser.parse_args(rclpy.utilities.remove_ros_args()[1:])

    rclpy.init()
    node = rclpy.create_node("ghand_control_startup")
    try:
        if args.stage == "hardware":
            error = activate(node, args.name, time.monotonic() + 30)
        else:
            action_name = f"/{args.name}/follow_joint_trajectory"
            client = ActionClient(node, FollowJointTrajectory, action_name)
            error = None if client.wait_for_server(timeout_sec=30.0) else (
                f"Timed out waiting for trajectory action {action_name}"
            )
        if error:
            node.get_logger().error(error)
            return 1
        return 0
    except (KeyboardInterrupt, rclpy.executors.ExternalShutdownException):
        return 0
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == "__main__":
    raise SystemExit(main())
