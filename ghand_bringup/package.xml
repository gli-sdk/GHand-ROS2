<?xml version="1.0"?>

<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>ghand_bringup</name>

  <version>1.0.0</version>

  <description>Launch and runtime configuration for GHand hardware and scene orchestration</description>

  <maintainer email="maintainers@glitech.cn">GHand ROS2 Maintainers</maintainer>

  <license>Apache-2.0</license>



  <url type="website">https://gitee.com/glitech/ghand-ros2</url>

  <url type="repository">https://gitee.com/glitech/ghand-ros2.git</url>

  <url type="bugtracker">https://gitee.com/glitech/ghand-ros2/issues</url>



  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>



  <exec_depend>controller_manager</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>ghand_description</exec_depend>

  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- Physical scenes require the separately built ghand_hardware_interface and ghand_controllers packages. -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
