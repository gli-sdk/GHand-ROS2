<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find ghand_bringup)/config/common/ghand_hardware_plugin.xacro"/>

  <xacro:macro name="ghand_ros2_control"
               params="use_mock_hardware:=false
                       use_gazebo:=false
                       prefix:=''
                       system_name:='ghand_hardware'
                       profile_file:=''
                       communication_type:=''
                       device:=''
                       baud_rate:=''
                       dbit_rate:=''
                       slave_id:=''
                       ifname:=''">
    <!-- Normalize the mock/gazebo flags so both '1' and 'true' are treated as enabled. -->
    <xacro:property name="_use_mock" scope="local"
                    value="${str(use_mock_hardware) in ['1', 'true', 'True']}"/>
    <xacro:property name="_use_gazebo" scope="local"
                    value="${str(use_gazebo) in ['1', 'true', 'True']}"/>
    <ros2_control name="${system_name}" type="system">
      <xacro:ghand_hardware_plugin
        use_mock_hardware="${_use_mock}" use_gazebo="${_use_gazebo}"
        profile_file="${profile_file}" communication_type="${communication_type}"
        device="${device}" baud_rate="${baud_rate}" dbit_rate="${dbit_rate}"
        slave_id="${slave_id}" ifname="${ifname}"
        tactile_region_counts="38,31,31,31,31"/>
      <joint name="${prefix}Thumb_IP">
        <state_interface name="position">
          <xacro:if value="${_use_mock}">
            <param name="initial_value">0.0</param>
          </xacro:if>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <xacro:unless value="${_use_mock}">
          <state_interface name="state"/>
          <state_interface name="error"/>
        </xacro:unless>
        <xacro:ghand_sdk_joint_interfaces commandable="false"
            enabled="${not _use_mock and not _use_gazebo}"/>
      </joint>
      <joint name="${prefix}Thumb_MCP">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position">
          <xacro:if value="${_use_mock}">
            <param name="initial_value">0.0</param>
          </xacro:if>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <xacro:unless value="${_use_mock}">
          <state_interface name="state"/>
          <state_interface name="error"/>
        </xacro:unless>
        <xacro:ghand_sdk_joint_interfaces commandable="true"
            enabled="${not _use_mock and not _use_gazebo}"/>
      </joint>
      <joint name="${prefix}Thumb_TMC_FE">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <xacro:unless value="${_use_mock}">
          <state_interface name="state"/>
          <state_interface name="error"/>
        </xacro:unless>
        <xacro:ghand_sdk_joint_interfaces commandable="true"
            enabled="${not _use_mock and not _use_gazebo}"/>
      </joint>
      <joint name="${prefix}Thumb_TMC_AA">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <xacro:if value="${_use_mock}">
          <state_interface name="position">
            <param name="initial_value">0.349065850398866</param>
          </state_interface>
        </xacro:if>
        <xacro:unless value="${_use_mock}">
          <state_interface name="position"/>
        </xacro:unless>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <xacro:unless value="${_use_mock}">
