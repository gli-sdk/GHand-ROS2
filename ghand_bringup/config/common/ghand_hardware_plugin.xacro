<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Percentages and SDK control fields are exposed only by real hardware. -->
  <xacro:macro name="ghand_sdk_joint_interfaces" params="commandable enabled">
    <xacro:if value="${enabled}">
      <xacro:if value="${commandable}">
        <command_interface name="current_percent"/>
        <command_interface name="control_mode"/>
        <command_interface name="loop_type"/>
        <command_interface name="control_state"/>
        <command_interface name="kp"/>
        <command_interface name="kd"/>
      </xacro:if>
      <state_interface name="current_percent"/>
      <state_interface name="control_mode"/>
      <state_interface name="loop_type"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="ghand_hardware_plugin" params="use_gazebo:=false
                       profile_file:=''
                       communication_type:=''
                       device:=''
                       baud_rate:=''
                       dbit_rate:=''
                       slave_id:=''
                       ifname:='' product_name:='ghand5' tactile_region_counts">
      <hardware>
        <xacro:if value="${use_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_gazebo}">
          <xacro:property name="profile" scope="local"
                          value="${xacro.load_yaml(profile_file)['hardware']}"/>

          <!-- Resolve unified parameters, applying legacy overrides when set. -->
          <xacro:property name="_communication_type" scope="local"
                          value="${communication_type if communication_type != '' else profile.get('communication_type', '')}"/>
          <xacro:property name="_device" scope="local"
                          value="${device if device != '' else profile.get('device', '')}"/>
          <xacro:property name="_baud_rate" scope="local"
                          value="${baud_rate if baud_rate != '' else profile.get('baud_rate', '')}"/>
          <xacro:property name="_data_rate" scope="local"
                          value="${dbit_rate if dbit_rate != '' else profile.get('data_rate', '')}"/>
          <xacro:property name="_node_id" scope="local"
                          value="${slave_id if slave_id != '' else profile.get('node_id', '')}"/>
          <xacro:property name="_ifname" scope="local"
                          value="${ifname if ifname != '' else profile.get('ifname', '')}"/>

          <plugin>ghand_hardware_interface/GHandHardwareInterface</plugin>
          <param name="product_name">${product_name}</param>

          <xacro:if value="${_communication_type != ''}">
            <param name="communication_type">${_communication_type}</param>
          </xacro:if>
          <xacro:if value="${_device != ''}">
            <param name="device">${_device}</param>
          </xacro:if>
          <xacro:if value="${_baud_rate != ''}">
            <param name="baud_rate">${_baud_rate}</param>
          </xacro:if>
          <xacro:if value="${_data_rate != ''}">
            <param name="data_rate">${_data_rate}</param>
          </xacro:if>
          <xacro:if value="${_node_id != ''}">
            <param name="node_id">${_node_id}</param>
          </xacro:if>
          <xacro:if value="${_ifname != ''}">
            <param name="ifname">${_ifname}</param>
          </xacro:if>

          <param name="control_mode">${profile.get('control_mode', 'position')}</param>

          <!-- SDK connection selection and ROS feedback freshness. -->
          <xacro:if value="${'hand_side' in profile}">
            <param name="hand_side">${profile['hand_side']}</param>
          </xacro:if>
          <xacro:if value="${'slave_index' in profile}">
            <param name="slave_index">${profile['slave_index']}</param>
          </xacro:if>
          <xacro:if value="${'read_timeout_ms' in profile}">
            <param name="read_timeout_ms">${profile['read_timeout_ms']}</param>
          </xacro:if>
          <param name="tactile_region_counts">${tactile_region_counts}</param>
        </xacro:unless>
      </hardware>
  </xacro:macro>
</robot>
