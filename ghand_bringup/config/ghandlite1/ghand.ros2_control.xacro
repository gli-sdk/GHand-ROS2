<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find ghand_bringup)/config/common/ghand_hardware_plugin.xacro"/>

  <xacro:macro name="ghandlite1_joint_resources" params="names prefix mock gazebo product">
    <xacro:if value="${len(names) > 0}">
      <xacro:property name="joint_name" value="${names[0]}"/>
      <joint name="${prefix}${joint_name}">
        <xacro:if value="${joint_name in product['active_joints']}">
          <command_interface name="position"/>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>
          <xacro:unless value="${mock or gazebo}">
            <command_interface name="current_percent"/>
            <command_interface name="control_mode"/>
            <command_interface name="control_state"/>
          </xacro:unless>
        </xacro:if>
        <state_interface name="position">
          <xacro:if value="${mock or gazebo}">
            <param name="initial_value">${product['initial_positions'][joint_name]}</param>
          </xacro:if>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <xacro:unless value="${mock or gazebo}">
          <state_interface name="state"/>
          <state_interface name="error"/>
          <state_interface name="current_percent"/>
          <state_interface name="control_mode"/>
        </xacro:unless>
      </joint>
      <xacro:ghandlite1_joint_resources names="${names[1:]}" prefix="${prefix}"
          mock="${mock}" gazebo="${gazebo}" product="${product}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="ghandlite1_tactile_points" params="count index:=0">
    <xacro:if value="${index &lt; count}">
      <state_interface name="distributed_force_${index}_x"/>
      <state_interface name="distributed_force_${index}_y"/>
      <state_interface name="distributed_force_${index}_z"/>
      <xacro:ghandlite1_tactile_points count="${count}" index="${index + 1}"/>
    </xacro:if>
  </xacro:macro>

  <xacro:macro name="ghandlite1_finger_sensor" params="name count prefix">
    <sensor name="${prefix}${name}">
      <state_interface name="resultant_force_x"/>
      <state_interface name="resultant_force_y"/>
      <state_interface name="resultant_force_z"/>
      <xacro:ghandlite1_tactile_points count="${count}"/>
    </sensor>
  </xacro:macro>

  <xacro:macro name="ghand_ros2_control"
      params="use_mock_hardware:=false use_gazebo:=false prefix:='' system_name:='ghand_hardware'
              profile_file:='' communication_type:='' device:='' baud_rate:='' dbit_rate:='' slave_id:='' ifname:=''">
    <xacro:property name="mock" value="${str(use_mock_hardware) in ['1', 'true', 'True']}"/>
    <xacro:property name="gazebo" value="${str(use_gazebo) in ['1', 'true', 'True']}"/>
    <xacro:property name="product_file" value="$(find ghand_description)/config/ghandlite1.yaml"/>
    <xacro:property name="product" value="${xacro.load_yaml(product_file)}"/>
    <xacro:property name="counts" value="${product['tactile_region_counts']}"/>
    <ros2_control name="${system_name}" type="system">
      <xacro:ghand_hardware_plugin use_mock_hardware="${mock}" use_gazebo="${gazebo}"
          product_name="ghandlite1" tactile_region_counts="${','.join([str(n) for n in counts])}"
          profile_file="${profile_file}" communication_type="${communication_type}"
          device="${device}" baud_rate="${baud_rate}" dbit_rate="${dbit_rate}"
          slave_id="${slave_id}" ifname="${ifname}"/>
      <xacro:ghandlite1_joint_resources names="${product['joints']}" prefix="${prefix}"
          mock="${mock}" gazebo="${gazebo}" product="${product}"/>
      <xacro:unless value="${mock or gazebo}">
        <xacro:ghandlite1_finger_sensor name="thumb" count="${counts[0]}" prefix="${prefix}"/>
        <xacro:ghandlite1_finger_sensor name="index" count="${counts[1]}" prefix="${prefix}"/>
        <xacro:ghandlite1_finger_sensor name="middle" count="${counts[2]}" prefix="${prefix}"/>
        <xacro:ghandlite1_finger_sensor name="ring" count="${counts[3]}" prefix="${prefix}"/>
        <xacro:ghandlite1_finger_sensor name="little" count="${counts[4]}" prefix="${prefix}"/>
<sensor name="${prefix}hand">
          <state_interface name="hand_state" />
          <state_interface name="temperature_raw" />
          <state_interface name="warning_0" />
          <state_interface name="warning_1" />
          <state_interface name="warning_2" />
          <state_interface name="warning_3" />
          <state_interface name="warning_4" />
          <state_interface name="warning_5" />
          <state_interface name="fault_0" />
          <state_interface name="fault_1" />
          <state_interface name="fault_2" />
          <state_interface name="fault_3" />
          <state_interface name="fault_4" />
          <state_interface name="fault_5" />
          <state_interface name="fault_6" />
          <state_interface name="fault_7" />
          <state_interface name="fault_8" />
          <state_interface name="fault_9" />
          <state_interface name="fault_10" />
          <state_interface name="fault_11" />
          <state_interface name="critical_0" />
          <state_interface name="critical_1" />
          <state_interface name="critical_2" />
          <state_interface name="critical_3" />
          <state_interface name="critical_4" />
          <state_interface name="critical_5" />
        </sensor>
      
      </xacro:unless>
    </ros2_control>
  </xacro:macro>
</robot>
