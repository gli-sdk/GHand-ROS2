<?xml version='1.0' encoding='utf-8'?>
<robot name="ghandlite1-right">
  <group name="hand">
    <link name="base_link" />
    <joint name="THUMB_TMC_FE" />
    <joint name="THUMB_TMC_AA" />
    <joint name="FF_MCP" />
    <joint name="MF_MCP" />
    <joint name="RF_MCP" />
    <joint name="LF_MCP" />
  </group>
  <passive_joint name="THUMB_MCP" />
  <passive_joint name="FF_IP" />
  <passive_joint name="MF_IP" />
  <passive_joint name="RF_IP" />
  <passive_joint name="LF_IP" />
  <group name="thumb">
    <chain base_link="base_link" tip_link="THUMB_MCP_Link" />
  </group>
  <group name="index_finger">
    <chain base_link="base_link" tip_link="FF_IP_Link" />
  </group>
  <group name="middle_finger">
    <chain base_link="base_link" tip_link="MF_IP_Link" />
  </group>
  <group name="ring_finger">
    <chain base_link="base_link" tip_link="RF_IP_Link" />
  </group>
  <group name="little_finger">
    <chain base_link="base_link" tip_link="LF_IP_Link" />
  </group>
  <group_state name="open" group="hand">
    <joint name="THUMB_TMC_FE" value="0.0" />
    <joint name="THUMB_TMC_AA" value="0.5235987755982988" />
    <joint name="FF_MCP" value="0.0" />
    <joint name="MF_MCP" value="0.0" />
    <joint name="RF_MCP" value="0.0" />
    <joint name="LF_MCP" value="0.0" />
  </group_state>
  <group_state name="fist" group="hand">
    <joint name="THUMB_TMC_FE" value="0.8" />
    <joint name="THUMB_TMC_AA" value="0.9" />
    <joint name="FF_MCP" value="1.5" />
    <joint name="MF_MCP" value="1.5" />
    <joint name="RF_MCP" value="1.5" />
    <joint name="LF_MCP" value="1.5" />
  </group_state>
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link" />
  <disable_collisions link1="base_link" link2="THUMB_TMC_AA_link" reason="Adjacent" />
  <disable_collisions link1="THUMB_TMC_AA_link" link2="THUMB_TMC_FE_Link" reason="Adjacent" />
  <disable_collisions link1="THUMB_TMC_FE_Link" link2="THUMB_MCP_Link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="FF_MCP_Link" reason="Adjacent" />
  <disable_collisions link1="FF_MCP_Link" link2="FF_IP_Link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="MF_MCP_Link" reason="Adjacent" />
  <disable_collisions link1="MF_MCP_Link" link2="MF_IP_Link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="RF_MCP_Link" reason="Adjacent" />
  <disable_collisions link1="RF_MCP_Link" link2="RF_IP_Link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="LF_MCP_Link" reason="Adjacent" />
  <disable_collisions link1="LF_MCP_Link" link2="LF_IP_Link" reason="Adjacent" />
</robot>