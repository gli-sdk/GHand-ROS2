<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Common Gazebo friction/contact properties for all GHand links.
       These are starting values; contact stability for a multi-finger hand
       usually requires iterative tuning. -->
  <xacro:macro name="ghand_gazebo_link_properties"
               params="link_name
                       mu1:=0.5
                       mu2:=0.5
                       kp:=1000.0
                       kd:=10.0
                       min_depth:=0.0001
                       max_vel:=0.01">
    <gazebo reference="${link_name}">
      <mu1>${mu1}</mu1>
      <mu2>${mu2}</mu2>
      <kp>${kp}</kp>
      <kd>${kd}</kd>
      <minDepth>${min_depth}</minDepth>
      <maxVel>${max_vel}</maxVel>
      <!-- Disable self-collision; the tightly packed finger links tend to
           jitter against each other with the default contact stiffness. -->
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>

  <!-- Disable gravity on a hand link.
       The hand is fixed to the world, so gravity serves no useful purpose here:
       it only drags the softly position-controlled (and the passive DIP) finger
       joints down onto their lower limits, where Gazebo reports an angle a hair
       past the limit (e.g. -0.0100001 vs -0.01). MoveIt/OMPL then reject that as
       an out-of-bounds start state and planning fails. Disabling gravity per
       link keeps world gravity acting on any grasp objects. -->
  <xacro:macro name="ghand_gazebo_disable_gravity" params="link_name">
    <gazebo reference="${link_name}">
      <gravity>false</gravity>
    </gazebo>
  </xacro:macro>

  <!-- Override a joint's lower position limit in Gazebo only.
       The source URDF keeps lower="0" for the flexor joints; Gazebo's solver
       lets a joint driven onto that hard limit penetrate slightly below zero,
       which MoveIt/OMPL then reject as an out-of-bounds start state. Widening
       the Gazebo limit to a small negative value absorbs the penetration while
       leaving the source description untouched. -->
  <xacro:macro name="ghand_gazebo_joint_limit_override"
               params="joint_name lower:=-0.01">
    <gazebo reference="${joint_name}">
      <lower>${lower}</lower>
    </gazebo>
  </xacro:macro>

  <!-- Fixed mount to the world frame for Gazebo.
       The hand has no arm, so without this its base_link is a free rigid body
       and gravity drops it to the floor. A `world` link + fixed joint pins the
       base at the given pose, matching the SRDF virtual_joint (world -> base_link).
       Default pose reproduces the previous launch set_pose hack (z=0.9, palm
       flipped 180deg about y so fingers point down). -->
  <xacro:macro name="ghand_world_fixed_joint"
               params="x:=0 y:=0 z:=0.9
                       roll:=0 pitch:=3.14159265359 yaw:=0 root_link:=base_link">
    <link name="world"/>
    <joint name="world_to_base" type="fixed">
      <parent link="world"/>
      <child link="${root_link}"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>
  </xacro:macro>

  <!-- Gazebo ros2_control plugin.
       The controller parameters are loaded from ghand_gazebo/config. -->
  <xacro:macro name="ghand_gazebo_ros2_control_plugin"
               params="ros2_control_params
                       controllers_params">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${ros2_control_params}</parameters>
        <parameters>${controllers_params}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
