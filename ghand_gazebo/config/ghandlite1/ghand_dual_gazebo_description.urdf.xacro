<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ghandlite1-dual">
  <xacro:include filename="$(find ghand_description)/urdf/ghandlite1/ghandlite1_dual_description.urdf" />
  <xacro:include filename="$(find ghand_gazebo)/config/common/ghand.gazebo.xacro" />
  <xacro:include filename="$(find ghand_gazebo)/config/ghandlite1/ghand.ros2_control.xacro" />
  <xacro:ghand_gazebo_ros2_control_plugin ros2_control_params="$(find ghand_gazebo)/config/ghandlite1/dual_controllers.yaml" controllers_params="$(find ghand_gazebo)/config/ghandlite1/dual_controllers.yaml" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_base_link" />
  <xacro:ghand_gazebo_link_properties link_name="left_base_link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_THUMB_TMC_AA_link" />
  <xacro:ghand_gazebo_link_properties link_name="left_THUMB_TMC_AA_link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_THUMB_TMC_FE_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_THUMB_TMC_FE_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_THUMB_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_THUMB_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_FF_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_FF_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_FF_IP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_FF_IP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_MF_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_MF_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_MF_IP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_MF_IP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_RF_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_RF_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_RF_IP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_RF_IP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_LF_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_LF_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="left_LF_IP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="left_LF_IP_Link" />
  <xacro:ghand_ros2_control prefix="left_" system_name="left_ghand_hardware" use_gazebo="true" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_base_link" />
  <xacro:ghand_gazebo_link_properties link_name="right_base_link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_THUMB_TMC_AA_link" />
  <xacro:ghand_gazebo_link_properties link_name="right_THUMB_TMC_AA_link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_THUMB_TMC_FE_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_THUMB_TMC_FE_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_THUMB_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_THUMB_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_FF_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_FF_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_FF_IP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_FF_IP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_MF_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_MF_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_MF_IP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_MF_IP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_RF_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_RF_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_RF_IP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_RF_IP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_LF_MCP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_LF_MCP_Link" />
  <xacro:ghand_gazebo_disable_gravity link_name="right_LF_IP_Link" />
  <xacro:ghand_gazebo_link_properties link_name="right_LF_IP_Link" />
  <xacro:ghand_ros2_control prefix="right_" system_name="right_ghand_hardware" use_gazebo="true" />
</robot>