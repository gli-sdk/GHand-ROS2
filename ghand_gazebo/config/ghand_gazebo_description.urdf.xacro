<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="product_name" default="ghand5"/>
  <xacro:arg name="hand_side" default="right"/>
  <xacro:attribute name="name" value="$(arg product_name)-$(arg hand_side)"/>
  <xacro:include filename="$(find ghand_gazebo)/config/$(arg product_name)/ghand_gazebo_description.urdf.xacro"/>
</robot>
