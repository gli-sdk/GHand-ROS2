<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ghand5-$(arg hand_side)">
  <xacro:arg name="hand_side" default="right"/>

  <!-- Base robot description from the external ghand_description package -->
  <xacro:if value="$(eval arg('hand_side') == 'left')">
    <xacro:include filename="$(find ghand_description)/urdf/ghand5_left_description.urdf"/>
  </xacro:if>
  <xacro:if value="$(eval arg('hand_side') == 'right')">
    <xacro:include filename="$(find ghand_description)/urdf/ghand5_right_description.urdf"/>
  </xacro:if>

  <!-- Gazebo-specific macros (world fixed joint, plugin, link properties) -->
  <xacro:include filename="$(find ghand_gazebo)/config/ghand.gazebo.xacro"/>
  <xacro:ghand_world_fixed_joint x="0.35" y="-0.08" z="0.95" roll="-1.57079632679" pitch="3.14159265359" yaw="1.57079632679"/>
  <xacro:ghand_gazebo_ros2_control_plugin
    ros2_control_params="$(find ghand_gazebo)/config/ros2_control.yaml"
    controllers_params="$(find ghand_gazebo)/config/ghand_gazebo_controllers.yaml"/>

  <!-- Disable gravity on every hand link. The hand is fixed to the world, so
       gravity serves no useful purpose here: it only drags the softly
       position-controlled fingers down onto their lower limits and makes the
       controller fight a steady load. World gravity still acts on any grasp
       objects. -->
  <xacro:ghand_gazebo_disable_gravity link_name="base_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="LF_MCP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="LF_PIP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="LF_DIP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="RF_MCP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="RF_PIP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="RF_DIP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="MF_MCP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="MF_PIP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="MF_DIP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="FF_MCP_AA_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="FF_MCP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="FF_PIP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="FF_DIP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="Thumb_TMC_PS_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="Thumb_TMC_AA_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="Thumb_TMC_FE_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="Thumb_MCP_link"/>
  <xacro:ghand_gazebo_disable_gravity link_name="Thumb_IP_link"/>

  <!-- Apply soft contact/self-collision properties to every link. -->
  <xacro:ghand_gazebo_link_properties link_name="base_link"/>
  <xacro:ghand_gazebo_link_properties link_name="LF_MCP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="LF_PIP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="LF_DIP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="RF_MCP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="RF_PIP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="RF_DIP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="MF_MCP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="MF_PIP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="MF_DIP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="FF_MCP_AA_link"/>
  <xacro:ghand_gazebo_link_properties link_name="FF_MCP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="FF_PIP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="FF_DIP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="Thumb_TMC_PS_link"/>
  <xacro:ghand_gazebo_link_properties link_name="Thumb_TMC_AA_link"/>
  <xacro:ghand_gazebo_link_properties link_name="Thumb_TMC_FE_link"/>
  <xacro:ghand_gazebo_link_properties link_name="Thumb_MCP_link"/>
  <xacro:ghand_gazebo_link_properties link_name="Thumb_IP_link"/>

  <!-- Gazebo ros2_control system: GazeboSimSystem drives the actuated joints.
       The DIP joints are passive and only expose state interfaces. -->
  <ros2_control name="GHandGazeboSystem" type="system">
    <hardware>
      <plugin name="gz_ros2_control::GazeboSimSystem">gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- Actuated joints (13 DOF used by the trajectory controller).
         Initial values match the SRDF "fist" group_state so Gazebo starts
         in a curled pose. -->
    <joint name="Thumb_MCP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.5</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Thumb_TMC_FE">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Thumb_TMC_AA">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.349065850398866</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="Thumb_TMC_PS">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.5</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="FF_PIP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="FF_MCP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="FF_MCP_AA">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="MF_PIP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="MF_MCP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="RF_PIP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="RF_MCP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="LF_PIP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="LF_MCP">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <!-- Passive DIP joints (state only). Values follow the PIP/MCP mimic
         coupling so the fingertips start curled in the fist pose. -->
    <joint name="Thumb_IP">
      <state_interface name="position"><param name="initial_value">0.5</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="FF_DIP">
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="MF_DIP">
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="RF_DIP">
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="LF_DIP">
      <state_interface name="position"><param name="initial_value">1.2</param></state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

</robot>
