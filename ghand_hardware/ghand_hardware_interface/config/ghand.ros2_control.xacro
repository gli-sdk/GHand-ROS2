<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="ghand_ros2_control"
               params="use_mock_hardware:=false
                       use_gazebo:=false
                       prefix:=''
                       system_name:='ghand_hardware'
                       profile_file:=''
                       communication_type:=''
                       device:=''
                       baud_rate:=''
                       dbit_rate:=''
                       slave_id:=''
                       ifname:=''">
    <ros2_control name="${system_name}" type="system">
      <hardware>
        <!-- Normalize the mock/gazebo flags so both '1' and 'true' are treated as enabled. -->
        <xacro:property name="_use_mock" scope="local"
                        value="${str(use_mock_hardware) in ['1', 'true', 'True']}"/>
        <xacro:property name="_use_gazebo" scope="local"
                        value="${str(use_gazebo) in ['1', 'true', 'True']}"/>
        <xacro:if value="${_use_gazebo}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${_use_gazebo}">
          <xacro:if value="${_use_mock}">
            <plugin>mock_components/GenericSystem</plugin>
            <param name="mock_sensor_commands">false</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>
          <xacro:unless value="${_use_mock}">
          <xacro:property name="profile" scope="local"
                          value="${xacro.load_yaml(profile_file)['hardware']}"/>

          <!-- Resolve unified parameters, applying legacy overrides when set. -->
          <xacro:property name="_communication_type" scope="local"
                          value="${communication_type if communication_type != '' else profile.get('communication_type', '')}"/>
          <xacro:property name="_device" scope="local"
                          value="${device if device != '' else profile.get('device', '')}"/>
          <xacro:property name="_baud_rate" scope="local"
                          value="${baud_rate if baud_rate != '' else profile.get('baud_rate', '')}"/>
          <xacro:property name="_data_rate" scope="local"
                          value="${dbit_rate if dbit_rate != '' else profile.get('data_rate', '')}"/>
          <xacro:property name="_node_id" scope="local"
                          value="${slave_id if slave_id != '' else profile.get('node_id', '')}"/>
          <xacro:property name="_ifname" scope="local"
                          value="${ifname if ifname != '' else profile.get('ifname', '')}"/>

          <plugin>ghand_hardware_interface/GHandHardwareInterface</plugin>

          <xacro:if value="${_communication_type != ''}">
            <param name="communication_type">${_communication_type}</param>
          </xacro:if>
          <xacro:if value="${_device != ''}">
            <param name="device">${_device}</param>
          </xacro:if>
          <xacro:if value="${_baud_rate != ''}">
            <param name="baud_rate">${_baud_rate}</param>
          </xacro:if>
          <xacro:if value="${_data_rate != ''}">
            <param name="data_rate">${_data_rate}</param>
          </xacro:if>
          <xacro:if value="${_node_id != ''}">
            <param name="node_id">${_node_id}</param>
          </xacro:if>
          <xacro:if value="${_ifname != ''}">
            <param name="ifname">${_ifname}</param>
          </xacro:if>

          <!-- Backend-specific settings carried by the profile. -->
          <xacro:if value="${'can_channel' in profile}">
            <param name="can_channel">${profile['can_channel']}</param>
          </xacro:if>
          <xacro:if value="${'serial_baud_rate' in profile}">
            <param name="serial_baud_rate">${profile['serial_baud_rate']}</param>
          </xacro:if>
          <xacro:if value="${'bitrate' in profile}">
            <param name="bitrate">${profile['bitrate']}</param>
          </xacro:if>
          <xacro:if value="${'can_clk' in profile}">
            <param name="can_clk">${profile['can_clk']}</param>
          </xacro:if>
          <xacro:if value="${'data_bits' in profile}">
            <param name="data_bits">${profile['data_bits']}</param>
          </xacro:if>
          <xacro:if value="${'stop_bits' in profile}">
            <param name="stop_bits">${profile['stop_bits']}</param>
          </xacro:if>
          <xacro:if value="${'parity' in profile}">
            <param name="parity">${profile['parity']}</param>
          </xacro:if>
          <xacro:if value="${'response_timeout_ms' in profile}">
            <param name="response_timeout_ms">${profile['response_timeout_ms']}</param>
          </xacro:if>
          <xacro:if value="${'read_timeout_ms' in profile}">
            <param name="read_timeout_ms">${profile['read_timeout_ms']}</param>
          </xacro:if>
          <xacro:if value="${'tactile_region_counts' in profile}">
            <param name="tactile_region_counts">${profile['tactile_region_counts']}</param>
          </xacro:if>
          </xacro:unless>
        </xacro:unless>
      </hardware>
      <joint name="${prefix}Thumb_IP">
        <state_interface name="position">
          <xacro:if value="${_use_mock}">
            <param name="initial_value">0.0</param>
          </xacro:if>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <xacro:unless value="${_use_mock}">
          <state_interface name="state"/>
          <state_interface name="error"/>
        </xacro:unless>
      </joint>
      <joint name="${prefix}Thumb_MCP">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position">
          <xacro:if value="${_use_mock}">
