<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ghand_hardware_interface</name>
  <version>1.0.0</version>
  <description>Hardware interface for GHand using ros2_control</description>
  <maintainer email="maintainers@glitech.cn">GHand ROS2 Maintainers</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://gitee.com/glitech/ghand-ros2</url>
  <url type="repository">https://gitee.com/glitech/ghand-ros2.git</url>
  <url type="bugtracker">https://gitee.com/glitech/ghand-ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <depend>ghand_sdk_vendor</depend>

  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_joint_trajectory_controller</exec_depend>
  <exec_depend>xacro</exec_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
