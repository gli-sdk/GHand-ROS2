<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ghand_hardware_interface</name>
  <version>1.0.0</version>
  <description>Hardware interface for GHand using ros2_control</description>
  <maintainer email="maintainers@glitech.cn">GHand ROS2 Maintainers</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://gitee.com/glitech/ghand-ros2</url>
  <url type="repository">https://gitee.com/glitech/ghand-ros2.git</url>
  <url type="bugtracker">https://gitee.com/glitech/ghand-ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <!-- Optional communication backends. They are detected at configure time;
       if a backend is not available on the system, the corresponding driver
       is compiled out and a warning is printed. -->
  <depend>libmodbus</depend>
  <depend>soem</depend>

  <exec_depend>controller_manager</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>effort_controllers</exec_depend>
  <exec_depend>ghand_description</exec_depend>
  <exec_depend>hand_controllers</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
