<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ghand_msgs</name>
  <version>1.0.0</version>
  <description>Custom messages for GHand</description>
  <maintainer email="maintainers@glitech.cn">GHand ROS2 Maintainers</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://gitee.com/glitech/ghand-ros2</url>
  <url type="repository">https://gitee.com/glitech/ghand-ros2.git</url>
  <url type="bugtracker">https://gitee.com/glitech/ghand-ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
