<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ghand">

  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.1 0.1 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Finger 1 -->
  <xacro:macro name="finger" params="prefix parent x y">
    <joint name="${prefix}_joint_1" type="revolute">
      <parent link="${parent}"/>
      <child link="${prefix}_link_1"/>
      <origin xyz="${x} ${y} 0.03" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.5" upper="0.5" effort="10.0" velocity="1.0"/>
    </joint>
    <link name="${prefix}_link_1">
      <visual>
        <geometry><cylinder radius="0.01" length="0.04"/></geometry>
        <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
      </visual>
      <inertial><mass value="0.05"/><inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/></inertial>
    </link>

    <joint name="${prefix}_joint_2" type="revolute">
      <parent link="${prefix}_link_1"/>
      <child link="${prefix}_link_2"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.5" upper="0.5" effort="10.0" velocity="1.0"/>
    </joint>
    <link name="${prefix}_link_2">
      <visual>
        <geometry><cylinder radius="0.008" length="0.03"/></geometry>
        <material name="blue"><color rgba="0.0 0.0 1.0 1.0"/></material>
      </visual>
      <inertial><mass value="0.03"/><inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/></inertial>
    </link>
  </xacro:macro>

  <xacro:finger prefix="finger_1" parent="base_link" x="0.04" y="0.04"/>
  <xacro:finger prefix="finger_2" parent="base_link" x="0.04" y="0.0"/>
  <xacro:finger prefix="finger_3" parent="base_link" x="0.04" y="-0.04"/>
  <xacro:finger prefix="thumb"    parent="base_link" x="-0.04" y="0.0"/>

  <!-- ros2_control -->
  <ros2_control name="GHandHardwareInterface" type="system">
    <hardware plugin="GHand_hardware/GHandHardwareInterface">
      <param name="example_param">1.0</param>
    </hardware>
    <joint name="finger_1_joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="finger_1_joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="finger_2_joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="finger_2_joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="finger_3_joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="finger_3_joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="thumb_joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="thumb_joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
