<?xml version="1.0" encoding="UTF-8"?>
<robot name="G5_right">
  <!--===== 全手规划组（18 关节，5 被动 DIP） =====-->
  <group name="hand">
    <link name="base_link"/>
    <joint name="thumb_mcp"/>
    <joint name="thumb_tmc_fe"/>
    <joint name="thumb_tmc_aa"/>
    <joint name="thumb_tmc_ps"/>
    <joint name="index_pip"/>
    <joint name="index_mcp"/>
    <joint name="index_mcp_aa"/>
    <joint name="middle_pip"/>
    <joint name="middle_mcp"/>
    <joint name="ring_pip"/>
    <joint name="ring_mcp"/>
    <joint name="little_pip"/>
    <joint name="little_mcp"/>
    <passive_joint name="thumb_dip"/>
    <passive_joint name="index_dip"/>
    <passive_joint name="middle_dip"/>
    <passive_joint name="ring_dip"/>
    <passive_joint name="little_dip"/>
  </group>

  <!--===== 单指规划组 =====-->
  <group name="index_finger">
    <chain base_link="base_link" tip_link="index_dip_link"/>
  </group>

  <group name="middle_finger">
    <chain base_link="base_link" tip_link="middle_dip_link"/>
  </group>

  <group name="ring_finger">
    <chain base_link="base_link" tip_link="ring_dip_link"/>
  </group>

  <group name="little_finger">
    <chain base_link="base_link" tip_link="little_dip_link"/>
  </group>

  <group name="thumb">
    <chain base_link="base_link" tip_link="thumb_dip_link"/>
  </group>

  <!--===== 指尖末端执行器组（只包含指尖 link） =====-->
  <group name="index_finger_tip">
    <link name="index_dip_link"/>
  </group>

  <group name="middle_finger_tip">
    <link name="middle_dip_link"/>
  </group>

  <group name="ring_finger_tip">
    <link name="ring_dip_link"/>
  </group>

  <group name="little_finger_tip">
    <link name="little_dip_link"/>
  </group>

  <group name="thumb_tip">
    <link name="thumb_dip_link"/>
  </group>

  <!--===== 预设手势 =====-->
  <group_state name="open" group="hand">
    <joint name="thumb_mcp" value="0.0"/>
    <joint name="thumb_tmc_fe" value="0.0"/>
    <joint name="thumb_tmc_aa" value="0.349065850398866"/>
    <joint name="thumb_tmc_ps" value="0.0"/>
    <joint name="index_pip" value="0.0"/>
    <joint name="index_mcp" value="0.0"/>
    <joint name="index_mcp_aa" value="0.0"/>
    <joint name="middle_pip" value="0.0"/>
    <joint name="middle_mcp" value="0.0"/>
    <joint name="ring_pip" value="0.0"/>
    <joint name="ring_mcp" value="0.0"/>
    <joint name="little_pip" value="0.0"/>
    <joint name="little_mcp" value="0.0"/>
  </group_state>

  <group_state name="fist" group="hand">
    <joint name="thumb_mcp" value="0.5"/>
    <joint name="thumb_tmc_fe" value="0"/>
    <joint name="thumb_tmc_aa" value="0.349065850398866"/>
    <joint name="thumb_tmc_ps" value="0.5"/>
    <joint name="index_pip" value="1.2"/>
    <joint name="index_mcp" value="1.2"/>
    <joint name="index_mcp_aa" value="0.0"/>
    <joint name="middle_pip" value="1.2"/>
    <joint name="middle_mcp" value="1.2"/>
    <joint name="ring_pip" value="1.2"/>
    <joint name="ring_mcp" value="1.2"/>
    <joint name="little_pip" value="1.2"/>
    <joint name="little_mcp" value="1.2"/>
  </group_state>

  <!--===== 末端执行器 =====-->
  <end_effector name="index_finger_tip" parent_link="index_dip_link" group="index_finger_tip" parent_group="index_finger"/>
  <end_effector name="middle_finger_tip" parent_link="middle_dip_link" group="middle_finger_tip" parent_group="middle_finger"/>
  <end_effector name="ring_finger_tip" parent_link="ring_dip_link" group="ring_finger_tip" parent_group="ring_finger"/>
  <end_effector name="little_finger_tip" parent_link="little_dip_link" group="little_finger_tip" parent_group="little_finger"/>
  <end_effector name="thumb_tip" parent_link="thumb_dip_link" group="thumb_tip" parent_group="thumb"/>

  <!--===== 自碰撞禁用规则 =====-->
  <!-- base_link 与手指根部：手掌和直接连在手掌上的关节，碰撞体通常重叠，禁用 -->
  <disable_collisions link1="base_link" link2="index_mcp_aa_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="index_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="middle_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="ring_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="little_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="thumb_tmc_ps_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="thumb_tmc_aa_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="thumb_tmc_fe_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="thumb_mcp_link" reason="Adjacent"/>

  <!-- 相邻关节对：同一根手指上直接相连的 link 不检测碰撞 -->
  <disable_collisions link1="index_dip_link" link2="index_pip_link" reason="Adjacent"/>
  <disable_collisions link1="index_mcp_aa_link" link2="index_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="index_mcp_link" link2="index_pip_link" reason="Adjacent"/>
  <disable_collisions link1="little_dip_link" link2="little_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="little_dip_link" link2="little_pip_link" reason="Adjacent"/>
  <disable_collisions link1="little_mcp_link" link2="little_pip_link" reason="Adjacent"/>
  <disable_collisions link1="middle_dip_link" link2="middle_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="middle_dip_link" link2="middle_pip_link" reason="Adjacent"/>
  <disable_collisions link1="middle_mcp_link" link2="middle_pip_link" reason="Adjacent"/>
  <disable_collisions link1="ring_dip_link" link2="ring_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="ring_dip_link" link2="ring_pip_link" reason="Adjacent"/>
  <disable_collisions link1="ring_mcp_link" link2="ring_pip_link" reason="Adjacent"/>
  <disable_collisions link1="thumb_dip_link" link2="thumb_mcp_link" reason="Adjacent"/>
  <disable_collisions link1="thumb_mcp_link" link2="thumb_tmc_fe_link" reason="Adjacent"/>
  <disable_collisions link1="thumb_tmc_fe_link" link2="thumb_tmc_aa_link" reason="Adjacent"/>
  <disable_collisions link1="thumb_tmc_aa_link" link2="thumb_tmc_ps_link" reason="Adjacent"/>
  <!-- 特殊相邻/无干涉对：index_mcp 与 thumb_tmc_fe -->
  <disable_collisions link1="index_mcp_link" link2="thumb_tmc_fe_link" reason="User"/>

  <!-- 无干涉组：middle/ring/little 三根手指内部任意 link 之间、以及它们与 thumb_tmc_fe 之间不检测碰撞 -->
  <disable_collisions link1="little_dip_link" link2="middle_dip_link" reason="User"/>
  <disable_collisions link1="little_dip_link" link2="middle_mcp_link" reason="User"/>
  <disable_collisions link1="little_dip_link" link2="middle_pip_link" reason="User"/>
  <disable_collisions link1="little_dip_link" link2="ring_dip_link" reason="User"/>
  <disable_collisions link1="little_dip_link" link2="ring_mcp_link" reason="User"/>
  <disable_collisions link1="little_dip_link" link2="ring_pip_link" reason="User"/>
  <disable_collisions link1="little_dip_link" link2="thumb_tmc_fe_link" reason="User"/>
  <disable_collisions link1="little_mcp_link" link2="middle_dip_link" reason="User"/>
  <disable_collisions link1="little_mcp_link" link2="middle_mcp_link" reason="User"/>
  <disable_collisions link1="little_mcp_link" link2="middle_pip_link" reason="User"/>
  <disable_collisions link1="little_mcp_link" link2="ring_dip_link" reason="User"/>
  <disable_collisions link1="little_mcp_link" link2="ring_mcp_link" reason="User"/>
  <disable_collisions link1="little_mcp_link" link2="ring_pip_link" reason="User"/>
  <disable_collisions link1="little_mcp_link" link2="thumb_tmc_fe_link" reason="User"/>
  <disable_collisions link1="little_pip_link" link2="middle_dip_link" reason="User"/>
  <disable_collisions link1="little_pip_link" link2="middle_mcp_link" reason="User"/>
  <disable_collisions link1="little_pip_link" link2="middle_pip_link" reason="User"/>
  <disable_collisions link1="little_pip_link" link2="ring_dip_link" reason="User"/>
  <disable_collisions link1="little_pip_link" link2="ring_mcp_link" reason="User"/>
  <disable_collisions link1="little_pip_link" link2="ring_pip_link" reason="User"/>
  <disable_collisions link1="little_pip_link" link2="thumb_tmc_fe_link" reason="User"/>
  <disable_collisions link1="middle_dip_link" link2="ring_dip_link" reason="User"/>
  <disable_collisions link1="middle_dip_link" link2="ring_mcp_link" reason="User"/>
  <disable_collisions link1="middle_dip_link" link2="ring_pip_link" reason="User"/>
  <disable_collisions link1="middle_dip_link" link2="thumb_tmc_fe_link" reason="User"/>
  <disable_collisions link1="middle_mcp_link" link2="ring_dip_link" reason="User"/>
  <disable_collisions link1="middle_mcp_link" link2="ring_mcp_link" reason="User"/>
  <disable_collisions link1="middle_mcp_link" link2="ring_pip_link" reason="User"/>
  <disable_collisions link1="middle_mcp_link" link2="thumb_tmc_fe_link" reason="User"/>
  <disable_collisions link1="middle_pip_link" link2="ring_dip_link" reason="User"/>
  <disable_collisions link1="middle_pip_link" link2="ring_mcp_link" reason="User"/>
  <disable_collisions link1="middle_pip_link" link2="ring_pip_link" reason="User"/>
  <disable_collisions link1="middle_pip_link" link2="thumb_tmc_fe_link" reason="User"/>
  <disable_collisions link1="ring_dip_link" link2="thumb_tmc_fe_link" reason="User"/>
  <disable_collisions link1="ring_mcp_link" link2="thumb_tmc_fe_link" reason="User"/>
  <disable_collisions link1="ring_pip_link" link2="thumb_tmc_fe_link" reason="User"/>


  <!--===== 虚拟关节 =====-->
  <!-- The world->base_link connection is provided by the URDF (a `world` link +
       `world_to_base` fixed joint, added under use_gazebo with the real mount
       pose). An SRDF virtual_joint here would duplicate that connection: in
       Gazebo runs move_group publishes the virtual joint's identity transform
       while robot_state_publisher publishes the URDF joint's real mount pose,
       so RViz draws the hand twice. The URDF joint is the single source. -->

</robot>
