<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="G5_right">
  <!-- Robot description imported from the external ghand_assets repository.
       Mesh paths are patched at build time to package://ghand_description/meshes. -->
  <xacro:include filename="$(find ghand_description)/urdf/G5_right_description.urdf"/>

  <!-- ros2_control -->
  <xacro:arg name="use_mock_hardware" default="false"/>
  <xacro:arg name="use_gazebo" default="false"/>
  <xacro:arg name="profile_file" default=""/>
  <xacro:arg name="communication_type" default=""/>
  <xacro:arg name="ifname" default=""/>
  <xacro:arg name="device" default=""/>
  <xacro:arg name="baud_rate" default=""/>
  <xacro:arg name="dbit_rate" default=""/>
  <xacro:arg name="slave_id" default=""/>

  <xacro:include filename="$(find ghand_description)/urdf/ghand.ros2_control.xacro"/>
  <xacro:ghand_ros2_control
    use_mock_hardware="$(arg use_mock_hardware)"
    use_gazebo="$(arg use_gazebo)"
    profile_file="$(arg profile_file)"
    communication_type="$(arg communication_type)"
    ifname="$(arg ifname)"
    device="$(arg device)"
    baud_rate="$(arg baud_rate)"
    dbit_rate="$(arg dbit_rate)"
    slave_id="$(arg slave_id)"/>

  <!-- Gazebo -->
  <xacro:include filename="$(find ghand_description)/urdf/ghand.gazebo.xacro"/>
  <!-- Pin the hand base to the world frame in Gazebo (otherwise it free-falls).
       Fingers point up (identity tilt); yaw=-90deg turns the palm to face -x
       (the scene front, toward the viewer). Base origin is the wrist bottom
       (STL z: 0..0.1055), so z=0.75 rests the wrist on the table surface. -->
  <xacro:if value="$(arg use_gazebo)">
    <xacro:ghand_world_fixed_joint x="0.05" y="0" z="0.75"
                                   roll="0" pitch="0" yaw="-1.57079632679"/>
  </xacro:if>
  <xacro:ghand_gazebo_link_properties link_name="base_link"/>
  <xacro:ghand_gazebo_link_properties link_name="little_mcp_link"/>
  <xacro:ghand_gazebo_link_properties link_name="little_pip_link"/>
  <xacro:ghand_gazebo_link_properties link_name="little_dip_link"/>
  <xacro:ghand_gazebo_link_properties link_name="ring_mcp_link"/>
  <xacro:ghand_gazebo_link_properties link_name="ring_pip_link"/>
  <xacro:ghand_gazebo_link_properties link_name="ring_dip_link"/>
  <xacro:ghand_gazebo_link_properties link_name="middle_mcp_link"/>
  <xacro:ghand_gazebo_link_properties link_name="middle_pip_link"/>
  <xacro:ghand_gazebo_link_properties link_name="middle_dip_link"/>
  <xacro:ghand_gazebo_link_properties link_name="index_mcp_aa_link"/>
  <xacro:ghand_gazebo_link_properties link_name="index_mcp_link"/>
  <xacro:ghand_gazebo_link_properties link_name="index_pip_link"/>
  <xacro:ghand_gazebo_link_properties link_name="index_dip_link"/>
  <xacro:ghand_gazebo_link_properties link_name="thumb_tmc_ps_link"/>
  <xacro:ghand_gazebo_link_properties link_name="thumb_tmc_aa_link"/>
  <xacro:ghand_gazebo_link_properties link_name="thumb_tmc_fe_link"/>
  <xacro:ghand_gazebo_link_properties link_name="thumb_mcp_link"/>
  <xacro:ghand_gazebo_link_properties link_name="thumb_dip_link"/>
  <xacro:ghand_gazebo_ros2_control_plugin
    ros2_control_params="$(find hand_bringup)/config/ros2_control.yaml"
    controllers_params="$(find hand_bringup)/config/controllers.yaml"/>

</robot>
