<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ghand_description</name>
  <version>1.0.0</version>
  <description>
    URDF and meshes for the GHand 5 dexterous hand. The description is sourced
    at build time from the ghand_assets checkout and installed as a standard
    ROS 2 description package (package:// mesh URIs).
  </description>
  <maintainer email="maintainers@glitech.cn">GHand ROS2 Maintainers</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://gitee.com/glitech/ghand-ros2</url>
  <url type="repository">https://gitee.com/glitech/ghand-ros2.git</url>
  <url type="bugtracker">https://gitee.com/glitech/ghand-ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
